Windows Registry Editor Version 5.00

; ============================================================
; Purpose: one command "net start MySQL80" brings up BOTH instances
;   - MySQL80   -> port 3306
;   - MySQL3308 -> port 3308 (project database, feedback_hub)
;
; How: Windows SCM starts a service's dependencies BEFORE the service
;      itself, so making MySQL80 depend on MySQL3308 makes one command
;      wake up both. Start=3 (DEMAND/manual) on both keeps them from
;      auto-starting at boot.
; ============================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\MySQL80]
"Start"=dword:00000003
"DependOnService"=hex(7):4d,00,79,00,53,00,51,00,4c,00,33,00,33,00,30,00,38,00,00,00,00,00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\MySQL3308]
"Start"=dword:00000003
